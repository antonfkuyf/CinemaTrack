@startuml
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam shadowing false

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #2C3E50
    ArrowColor #2C3E50
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}

left to right direction

actor "Администратор" as Admin
actor "Зритель" as Viewer

rectangle "Информационная система «CinemaTrack»" {

  usecase "Авторизация" as UC_Auth
  usecase "Регистрация нового\nпользователя (админ/зритель)" as UC_RegNew
  usecase "Управление репертуаром\n(добавление/изменение/удаление)" as UC_ManageFilms
  usecase "Создание и удаление сеансов" as UC_ManageSessions
  usecase "Продажа билета\nчерез кассу" as UC_SellBox
  usecase "Оформление возврата билета" as UC_Refund
  usecase "Просмотр статистики продаж" as UC_Stats

  usecase "Регистрация" as UC_RegViewer
  usecase "Просмотр афиши и расписания" as UC_ViewPoster
  usecase "Выбор места в зале" as UC_ChooseSeat
  usecase "Покупка билета онлайн" as UC_BuyOnline
  usecase "Просмотр истории покупок" as UC_History

  Admin --> UC_Auth
  Admin --> UC_RegNew
  Admin --> UC_ManageFilms
  Admin --> UC_ManageSessions
  Admin --> UC_SellBox
  Admin --> UC_Refund
  Admin --> UC_Stats

  Viewer --> UC_Auth
  Viewer --> UC_RegViewer
  Viewer --> UC_ViewPoster
  Viewer --> UC_ChooseSeat
  Viewer --> UC_BuyOnline
  Viewer --> UC_History

  UC_BuyOnline ..> UC_ChooseSeat : <<include>>
  UC_BuyOnline ..> UC_Auth : <<include>>
}
@enduml
